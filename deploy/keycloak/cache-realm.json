{
  "realm": "cache",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "accessTokenLifespan": 300,
  "roles": {
    "realm": [
      {
        "name": "cache-user"
      },
      {
        "name": "cache-admin"
      }
    ]
  },
  "clients": [
    {
      "clientId": "cache-api",
      "bearerOnly": true,
      "enabled": true
    },
    {
      "clientId": "cache-console",
      "enabled": true,
      "publicClient": false,
      "secret": "${KEYCLOAK_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:3000/api/auth/callback/keycloak"
      ],
      "webOrigins": [
        "http://localhost:3000"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "cache-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "cache-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "cache-realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "multivalued": "true",
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "cache-user",
      "enabled": true,
      "email": "user@cache.local",
      "emailVerified": true,
      "firstName": "Cache",
      "lastName": "User",
      "credentials": [
        {
          "type": "password",
          "value": "${KEYCLOAK_USER_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": [
        "cache-user"
      ]
    },
    {
      "username": "cache-admin",
      "enabled": true,
      "email": "admin@cache.local",
      "emailVerified": true,
      "firstName": "Cache",
      "lastName": "Admin",
      "credentials": [
        {
          "type": "password",
          "value": "${KEYCLOAK_ADMIN_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": [
        "cache-admin",
        "cache-user"
      ]
    }
  ]
}
